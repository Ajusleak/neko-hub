{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neikos.local/schemas/api-envelope.schema.json",
  "title": "NEIKOS API Result Envelope",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "data", "requestId", "timestamp"],
      "properties": {
        "ok": { "const": true },
        "data": {},
        "requestId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["ok", "error", "requestId", "timestamp"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "field": { "type": "string" },
            "retryable": { "type": "boolean" },
            "details": { "type": "object" }
          },
          "additionalProperties": false
        },
        "requestId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  ]
}
